# ---- AWS / Bedrock (Nova 2 Sonic speech-to-speech) ----
AWS_REGION=us-east-1
# Standard AWS credential chain is used (env vars, SSO, or ~/.aws/credentials).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Voice core provider: nova_bidi (Strands experimental BidiAgent, default)
# or nova_native (raw bedrock-runtime bidirectional stream, fallback path).
MODEL_PROVIDER=nova_bidi
NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_SONIC_VOICE=matthew

# Text model for the Planner + Scribe (Bedrock). Nova Lite keeps model-access
# grants minimal; swap for us.anthropic.claude-sonnet-4-6 for richer extraction.
TEXT_MODEL_ID=us.amazon.nova-lite-v1:0

# ---- Twilio (outbound call + Media Streams) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Publicly reachable wss:// base for Twilio to stream call audio to.
# Local dev: an ngrok/cloudflared tunnel to the FastAPI bridge. e.g. wss://xxxx.ngrok.app
PUBLIC_WS_URL=

# ---- Practice IVR (Day 3 demo fixture) ----
PRACTICE_IVR_NUMBER=+1XXXXXXXXXX

# ---- State ----
# dynamodb (default; needs AWS + `python scripts/create_tables.py`) or memory
# (in-process; for local dev / demo without DynamoDB).
STATE_BACKEND=dynamodb
DDB_TABLE_PREFIX=holdline
# Provider memory: local (in-process, no setup) or agentcore (Bedrock AgentCore
# Memory, durable). agentcore needs `pip install -e ".[agentcore]"`.
MEMORY_BACKEND=local
# AgentCore Memory store id; blank = create_or_get one named holdline_provider_memory.
AGENTCORE_MEMORY_ID=
# Run each call through the Strands Graph (planner -> call -> debrief). false =
# call the same steps directly.
USE_GRAPH=true

# ---- Supervisor / mid-call escalation ----
SUPERVISOR_ENABLED=true
SUPERVISOR_INTERVAL_S=6
SUPERVISOR_MAX_CHECKS=20
ESCALATION_TIMEOUT_S=90

# ---- Observability (Strands OpenTelemetry) ----
TRACING_ENABLED=true
TRACING_CONSOLE=false
OTEL_SERVICE_NAME=holdline
# Point at a collector to see spans (Jaeger / Langfuse / Grafana Tempo / ADOT->X-Ray):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20...

# ---- Dashboard ----
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
