# ---- AWS / Bedrock (Nova 2 Sonic speech-to-speech) ----
AWS_REGION=us-east-1
# Standard AWS credential chain is used (env vars, SSO, or ~/.aws/credentials).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Voice core provider: nova_bidi (Strands experimental BidiAgent, default)
# or nova_native (raw bedrock-runtime bidirectional stream, fallback path).
MODEL_PROVIDER=nova_bidi
NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_SONIC_VOICE=matthew

# ---- Twilio (outbound call + Media Streams) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Publicly reachable wss:// base for Twilio to stream call audio to.
# Local dev: an ngrok/cloudflared tunnel to the FastAPI bridge. e.g. wss://xxxx.ngrok.app
PUBLIC_WS_URL=

# ---- Practice IVR (Day 3 demo fixture) ----
PRACTICE_IVR_NUMBER=+1XXXXXXXXXX

# ---- State ----
DDB_TABLE_PREFIX=holdline
# AgentCore Memory store id (Day 7); blank = skip memory.
AGENTCORE_MEMORY_ID=

# ---- Dashboard ----
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
